# Public build-time URLs; never put secrets in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_AUTH_URL=http://localhost:4000/v1
# Production uses the deployed HTTPS Render API URLs. Coordinator cookies are HttpOnly,
# Secure and SameSite=None; set the exact Vercel origin in Render FRONTEND_URL.
