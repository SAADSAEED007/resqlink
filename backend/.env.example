NODE_ENV=development
ENV=development
PORT=4000
SERVER_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
# Required: supply a real local MongoDB URI or Atlas connection string.
DATABASE_URL=mongodb+srv://<db_username>:<db_password>@cluster0.5sdhcug.mongodb.net/<db_name>?retryWrites=true&w=majority
# Optional for now: email sending is skipped when the key is not configured.
# EMAIL_SERVICE_API_KEY=
# Required for inherited authentication. Generate two different random secrets.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
# Optional: inherited migration CLI only; configure before running migrations.
MIGRATE_MONGO_URI=
MIGRATE_AUTOSYNC=false
# Inherited template setting; current hashing utility uses a fixed cost of 10.
SALT_ROUNDS=10
